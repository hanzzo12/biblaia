{
  "name": "rotation-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "დიპლომატიური როტაციის კალკულატორი — ბრძანება №01-82 (ოფლაინ HTML + Cloudflare Worker)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/ tests/data/ tests/providers/ tests/worker/",
    "test:golden": "python3 -I tests/independent/compute_golden.py",
    "test:e2e": "node --test tests/e2e/",
    "test:all": "npm run validate:data && npm run build && npm test && npm run test:e2e",
    "dev": "npm run build && wrangler dev",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dry",
    "deploy": "npm run build && wrangler deploy",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@fontsource/noto-sans-georgian": "5.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "wrangler": "4.155.0"
  }
}
