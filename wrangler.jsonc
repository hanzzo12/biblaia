{
  // Cloudflare Workers Static Assets + /api/market. შემოწმებულია wrangler 4.155.0-ით (deploy --dry-run).
  // აქ მხოლოდ არასაიდუმლო პარამეტრებია. საჯარო (Eurostat) რეჟიმს საიდუმლო არ სჭირდება.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rotation-calculator",
  "main": "worker/index.js",
  // wrangler 4.155.0-ს თან ახლავს workerd 1.20261023.1 — თარიღი ამაზე გვიანი არ იყოს.
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist/web/",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // /api/* ყოველთვის Worker-ს მიდის, სტატიკური ფაილი მას ვერ დაჩრდილავს.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // საჯარო ვერსია (ADR-002): Eurostat-ის ოფიციალური კოეფიციენტები, გასაღები არ სჭირდება.
    // "numbeo" — მხოლოდ Numbeo-ს ლიცენზიით + `wrangler secret put NUMBEO_API_KEY` (იხ. docs/deploy.md, დანართი ა).
    "MARKET_PROVIDER": "eurostat",
    // Eurostat-ის ლიცენზია ქეშირებას უშვებს: 24 სთ. Numbeo-ს რეჟიმში დააყენეთ "0" ლიცენზიის დადასტურებამდე.
    "MARKET_CACHE_TTL_SECONDS": "86400",
    // ვადაგასული ასლის ჩვენება upstream შეცდომისას (წამი; 7 დღე). მოქმედებს მხოლოდ TTL > 0-ისას.
    "MARKET_STALE_MAX_SECONDS": "604800",
    "MARKET_UPSTREAM_TIMEOUT_MS": "8000",
    "MARKET_ALLOWED_CURRENCIES": "EUR,USD",
    // მხოლოდ Numbeo-ს რეჟიმისთვის: "true" ლიცენზიის დადასტურების შემდეგ.
    "MARKET_LICENSE_CONFIRMED": "false"
  },
  "ratelimits": [
    // მიახლოებითი ლიმიტი თითო Cloudflare ლოკაციაზე; period მხოლოდ 10 ან 60.
    { "name": "MARKET_RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // საჯარო გვერდი: workers.dev ან საკუთარი დომენი. Access საჭირო არ არის (ADR-002).
  "workers_dev": true,
  "preview_urls": false
}
