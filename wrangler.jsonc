{
  // Cloudflare **Workers** კონფიგურაცია (CLI გზა, დანართი). Pages-ის Git გზას ეს ფაილი არ სჭირდება — იხ. docs/deploy-pages.md.
  // ფაილს განზრახ არ ჰქვია wrangler.jsonc: Pages-ის build/`wrangler pages dev` მას Pages-ის კონფიგად წაიკითხავდა.
  // გამოყენება: npx wrangler deploy --config wrangler.jsonc (npm run deploy). შემოწმებულია wrangler 4.155.0-ით.
  // აქ მხოლოდ არასაიდუმლო პარამეტრებია. APIFY_TOKEN → `npx wrangler secret put APIFY_TOKEN` (ლოკალურად — .dev.vars).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rotation-calculator",
  "main": "worker/index.js",
  // wrangler 4.155.0-ს თან ახლავს workerd 1.20261023.1 — თარიღი ამაზე გვიანი არ იყოს.
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist/web/",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // /api/* ყოველთვის Worker-ს მიდის, სტატიკური ფაილი მას ვერ დაჩრდილავს.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // "apify" (ნაგულისხმევი) | "off" — ბაზრის მონაცემების სრული გამორთვა (status "disabled").
    "MARKET_PROVIDER": "apify",
    "MARKET_CACHE_TTL_DAYS": "30",
    // ვადაგასული ასლის ჩვენება upstream-ის ჩავარდნისას (დღე).
    "MARKET_STALE_MAX_DAYS": "365",
    // Apify-ის სინქრონული გაშვების ლოდინი (მწმ); განმეორებითი ცდა არ არის.
    "MARKET_UPSTREAM_TIMEOUT_MS": "90000",
    "MARKET_ALLOWED_CURRENCIES": "EUR,USD",
    // "false" — ინდექსები (rankings, ≈ $2.745 ერთ გაშვებაზე / 30 დღე) გამორთულია; ფასები რჩება.
    "MARKET_RANKINGS_ENABLED": "true"
  },
  // Workers KV ქეში: id არ არის მითითებული — `wrangler deploy` (4.x) პირველ განთავსებაზე KV-ს ავტომატურად ქმნის და მიაბამს.
  // KV-ის გარეშე (id არ არის) Worker იყენებს Cache API-ს/მეხსიერებას — ამისთვის ეს ბლოკი წაშალეთ.
  "kv_namespaces": [
    { "binding": "MARKET_CACHE" }
  ],
  "ratelimits": [
    // მიახლოებითი ლიმიტი თითო IP-ზე და Cloudflare ლოკაციაზე; period მხოლოდ 10 ან 60.
    { "name": "MARKET_RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // საჯარო გვერდი: workers.dev ან საკუთარი დომენი (ADR-003).
  "workers_dev": true,
  "preview_urls": false
}
